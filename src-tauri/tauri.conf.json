{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aura Studio",
  "version": "0.1.0",
  "identifier": "com.aurastudio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Aura Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/images/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDNUY3RENEMjk1ODlFMTkKUldRWm5sZ3B6WDFmUE5RWnBkWEduVWxCdXhNKzBPancvdGVmZGx5d2RpVW1tcnlIMUNtSGdIeVkK",
      "endpoints": [
        "https://github.com/jsalamanc/appoiments-app/releases/latest/download/latest.json"
      ]
    }
  }
}
